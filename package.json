{
  "name": "tabular-file-diff-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:playground && vite --config site/vite.config.js",
    "test": "node --check site/public/playground/worker.js && tsc -p site/tsconfig.json && vitest run --config site/vitest.config.js",
    "test:a11y": "playwright test -c site/playwright.config.ts",
    "test:claims": "playwright test -c site/playwright.config.ts",
    "test:python": ".venv/bin/pytest",
    "build": "npm run build:site",
    "prepare:playground": "python3 scripts/build_playground_wheel.py && node scripts/prepare-playground.mjs",
    "build:site": "npm run prepare:playground && vite build --config site/vite.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "pyodide": "^0.27.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
